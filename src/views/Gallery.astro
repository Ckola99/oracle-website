---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { gallery } from '../lib/content';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<BaseLayout lang={lang} page="gallery" title={t(lang, 'gallery.title')} description={t(lang, 'gallery.metaDescription')}>
  <PageHeader eyebrow={t(lang, 'gallery.eyebrow')} title={t(lang, 'gallery.heading')} intro={t(lang, 'gallery.intro')} />
  <section class="py-14 sm:py-16">
    <div class="container-page"><GalleryGrid lang={lang} items={gallery} /></div>
  </section>
</BaseLayout>
