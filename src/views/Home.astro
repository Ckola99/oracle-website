---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CardGrid from '../components/CardGrid.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import TestimonialList from '../components/TestimonialList.astro';
import AfricaMap from '../components/AfricaMap.astro';
import CtaBand from '../components/CtaBand.astro';
import logoFull from '../assets/brand/logo-full.png';
import { partners, testimonials, has } from '../lib/content';
import { t, path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const cards = t<{ title: string; text: string }[]>(lang, 'home.cards');
---

<BaseLayout lang={lang} page="home" title={t(lang, 'home.title')}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-offwhite to-white">
    <div class="container-page grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1.15fr_1fr] lg:py-24">
      <div>
        <p class="eyebrow">{t(lang, 'home.heroEyebrow')}</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight sm:text-5xl">{t(lang, 'home.heroTitle')}</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{t(lang, 'home.heroText')}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={path(lang, 'contact')} class="btn btn-primary">{t(lang, 'common.contactUs')}</a>
          <a href={path(lang, 'services')} class="btn btn-outline">{t(lang, 'home.heroSecondary')}</a>
        </div>
      </div>
      <div class="mx-auto w-full max-w-xs sm:max-w-sm lg:max-w-md">
        <Image src={logoFull} alt={t(lang, 'meta.logoAlt')} widths={[320, 480, 640, 900]} sizes="(min-width: 1024px) 448px, (min-width: 640px) 384px, 320px" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <SectionTitle eyebrow={t(lang, 'home.whatEyebrow')} title={t(lang, 'home.whatTitle')} intro={t(lang, 'home.whatIntro')} />
      <div class="mt-10"><CardGrid items={cards} /></div>
      <a href={path(lang, 'services')} class="mt-8 inline-block font-heading text-sm font-semibold">{t(lang, 'common.learnMore')} →</a>
    </div>
  </section>

  {
    has.partners && (
      <section class="border-y border-navy/10 bg-offwhite py-16">
        <div class="container-page">
          <SectionTitle eyebrow={t(lang, 'home.partnersEyebrow')} title={t(lang, 'home.partnersTitle')} />
          <div class="mt-8"><PartnerGrid lang={lang} partners={partners.slice(0, 8)} /></div>
          <a href={path(lang, 'partners')} class="mt-8 inline-block font-heading text-sm font-semibold">{t(lang, 'home.partnersLink')} →</a>
        </div>
      </section>
    )
  }

  <!-- Map teaser -->
  <section class="py-16 sm:py-20">
    <div class="container-page grid items-center gap-10 md:grid-cols-2">
      <div>
        <SectionTitle eyebrow={t(lang, 'home.mapEyebrow')} title={t(lang, 'home.mapTitle')} intro={t(lang, 'home.mapText')} />
        <a href={path(lang, 'where')} class="btn btn-outline mt-8">{t(lang, 'home.mapLink')}</a>
      </div>
      <div class="mx-auto w-full max-w-sm"><AfricaMap lang={lang} /></div>
    </div>
  </section>

  {
    has.testimonials && (
      <section class="border-t border-navy/10 bg-offwhite py-16 sm:py-20">
        <div class="container-page">
          <SectionTitle eyebrow={t(lang, 'home.testimonialsEyebrow')} title={t(lang, 'home.testimonialsTitle')} />
          <div class="mt-10"><TestimonialList lang={lang} items={testimonials.slice(0, 2)} /></div>
        </div>
      </section>
    )
  }

  <CtaBand lang={lang} />
</BaseLayout>
