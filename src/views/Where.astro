---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AfricaMap from '../components/AfricaMap.astro';
import CtaBand from '../components/CtaBand.astro';
import { countries, localized } from '../lib/content';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const order = { base: 0, active: 1, potential: 2 } as const;
const sorted = [...countries].sort(
  (a, b) => order[a.status] - order[b.status] || localized(a, 'name', lang).localeCompare(localized(b, 'name', lang), lang),
);
const statuses = (['base', 'active', 'potential'] as const).filter((s) => countries.some((c) => c.status === s));
const swatch = { base: 'bg-gold-light', active: 'bg-royal', potential: 'bg-[#8fb3d9]' } as const;
---

<BaseLayout lang={lang} page="where" title={t(lang, 'where.title')} description={t(lang, 'where.metaDescription')}>
  <PageHeader eyebrow={t(lang, 'where.eyebrow')} title={t(lang, 'where.heading')} intro={t(lang, 'where.intro')} />

  <section class="py-14 sm:py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-start">
      <div class="mx-auto w-full max-w-lg">
        <AfricaMap lang={lang} interactive />
        <div class="mt-4">
          <h2 class="sr-only">{t(lang, 'where.legendTitle')}</h2>
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
            {
              statuses.map((s) => (
                <li class="flex items-center gap-2">
                  <span class:list={['inline-block size-3 rounded-sm', swatch[s]]} aria-hidden="true" />
                  {t(lang, `where.status.${s}`)}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold">{t(lang, 'where.listTitle')}</h2>
        <ul class="mt-6 space-y-4">
          {
            sorted.map((c) => (
              <li id={`country-${c.iso}`} class="country-card scroll-mt-28 rounded-lg border border-navy/10 bg-white p-5 transition-shadow target:border-gold target:shadow-[0_0_0_3px_rgb(203_170_96/0.35)]">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-lg font-semibold">{localized(c, 'name', lang)}</h3>
                  <span class="flex shrink-0 items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted">
                    <span class:list={['inline-block size-2.5 rounded-full', swatch[c.status]]} aria-hidden="true" />
                    {t(lang, `where.status.${c.status}`)}
                  </span>
                </div>
                <p class="mt-3 leading-relaxed text-muted">
                  <span class="sr-only">{t(lang, 'where.potentialLabel')} : </span>
                  {localized(c, 'potential', lang)}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
