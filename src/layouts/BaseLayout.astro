---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { t, path, otherLang, htmlLang, ogLocale, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Current page key — used for the language switcher, hreflang and nav highlighting. */
  page?: RouteKey;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, page, title, description = t(lang, 'meta.defaultDescription'), noindex = false } = Astro.props;
const siteName = t(lang, 'meta.siteName');
const fullTitle = !title || page === 'home' ? (title ?? siteName) : `${title} | ${siteName}`;
const alt = otherLang(lang);
const canonical = page ? new URL(path(lang, page), Astro.site) : undefined;
const alternates = page
  ? [
      { hreflang: 'fr', href: new URL(path('fr', page), Astro.site).href },
      { hreflang: 'en', href: new URL(path('en', page), Astro.site).href },
      { hreflang: 'x-default', href: new URL(path('fr', page), Astro.site).href },
    ]
  : [];
const ogImage = new URL('/og-image.jpg', Astro.site).href;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.companyName,
  url: site.url,
  logo: new URL('/icon-512.png', Astro.site).href,
  email: site.emails.general,
  slogan: t(lang, 'common.tagline'),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.countryCode,
    ...(site.address ? { streetAddress: site.address } : {}),
  },
  ...(site.phone ? { telephone: site.phone } : {}),
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'customer service', email: site.emails.general, availableLanguage: ['French', 'English'] },
    { '@type': 'ContactPoint', contactType: 'sales', email: site.emails.sales, availableLanguage: ['French', 'English'] },
  ],
  sameAs: Object.values(site.social).filter(Boolean),
};
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical.href} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a1e4c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[alt]} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta name="twitter:card" content="summary_large_image" />

    {page === 'home' && <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">
      {t(lang, 'meta.skipToContent')}
    </a>
    <Header lang={lang} page={page} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
