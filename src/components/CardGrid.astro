---
interface Props {
  items: { title: string; text: string }[];
  /** Show 01, 02, 03 numbers (for process steps). */
  numbered?: boolean;
}
const { items, numbered = false } = Astro.props;
---

<ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role={numbered ? undefined : 'list'}>
  {
    items.map((item, i) => (
      <li class="rounded-lg border border-navy/10 bg-white p-6 shadow-[0_1px_2px_rgb(10_30_76/0.04)]">
        {numbered ? (
          <span class="font-heading text-3xl font-bold text-gold" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        ) : (
          <span class="block h-0.5 w-10 bg-gold-light" aria-hidden="true" />
        )}
        <h3 class="mt-4 text-lg font-semibold">{item.title}</h3>
        <p class="mt-2 leading-relaxed text-muted">{item.text}</p>
      </li>
    ))
  }
</ol>
