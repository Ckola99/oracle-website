---
// Africa map rendered to static SVG at build time (no map JS shipped to the browser).
// Country colours come from src/data/countries.json.
import { geoMercator, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import { countries, localized } from '../lib/content';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Make highlighted countries focusable/clickable (links to their card via #country-XX). */
  interactive?: boolean;
  class?: string;
}
const { lang, interactive = false, class: className = '' } = Astro.props;

// ISO 3166 numeric → alpha-2 for African countries in the 110m dataset.
// (Small island states — Cabo Verde, Comoros, Mauritius, São Tomé, Seychelles — are too small to appear.)
const AFRICA: Record<string, string> = {
  '012': 'DZ', '024': 'AO', '204': 'BJ', '072': 'BW', '854': 'BF', '108': 'BI', '120': 'CM', '140': 'CF',
  '148': 'TD', '178': 'CG', '180': 'CD', '384': 'CI', '262': 'DJ', '818': 'EG', '226': 'GQ', '232': 'ER',
  '748': 'SZ', '231': 'ET', '266': 'GA', '270': 'GM', '288': 'GH', '324': 'GN', '624': 'GW', '404': 'KE',
  '426': 'LS', '430': 'LR', '434': 'LY', '450': 'MG', '454': 'MW', '466': 'ML', '478': 'MR', '504': 'MA',
  '508': 'MZ', '516': 'NA', '562': 'NE', '566': 'NG', '646': 'RW', '686': 'SN', '694': 'SL', '706': 'SO',
  '710': 'ZA', '728': 'SS', '729': 'SD', '834': 'TZ', '768': 'TG', '788': 'TN', '800': 'UG', '894': 'ZM',
  '716': 'ZW', '732': 'EH',
};

const topo = world as any;
const all = (feature(topo, topo.objects.countries) as any).features as any[];
const shapes = all
  .map((f) => ({ f, iso: f.properties.name === 'Somaliland' ? 'SO' : AFRICA[f.id] }))
  .filter((s) => s.iso);

const W = 600;
const H = 640;
const projection = geoMercator().fitExtent(
  [[10, 10], [W - 10, H - 10]],
  { type: 'FeatureCollection', features: shapes.map((s) => s.f) } as any,
);
const pathGen = geoPath(projection).digits(1);

const byIso = new Map(countries.map((c) => [c.iso, c]));
const fills = { base: '#cbaa60', active: '#135b9a', potential: '#8fb3d9' } as const;

const paths = shapes.map(({ f, iso }) => {
  const c = byIso.get(iso);
  return {
    d: pathGen(f) ?? '',
    iso,
    country: c,
    fill: c ? fills[c.status] : '#e3e7ee',
    name: c ? localized(c, 'name', lang) : undefined,
  };
});
// Draw highlighted countries last so their outlines sit on top.
paths.sort((a, b) => Number(!!a.country) - Number(!!b.country));

const [kx, ky] = projection([25.47, -10.71]) ?? [0, 0]; // Kolwezi
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t(lang, 'where.mapLabel')} class:list={['h-auto w-full', className]}>
  <g stroke="#ffffff" stroke-width="0.8" stroke-linejoin="round">
    {
      paths.map((p) =>
        p.country && interactive ? (
          <a href={`#country-${p.iso}`} class="map-country" aria-label={p.name}>
            <path d={p.d} fill={p.fill} class="transition-opacity hover:opacity-80">
              <title>{p.name}</title>
            </path>
          </a>
        ) : (
          <path d={p.d} fill={p.fill}>{p.name && <title>{p.name}</title>}</path>
        ),
      )
    }
  </g>
  <g aria-hidden="true">
    <circle cx={kx} cy={ky} r="11" fill="#0a1e4c" opacity="0.15" />
    <circle cx={kx} cy={ky} r="5" fill="#0a1e4c" stroke="#fff" stroke-width="1.5" />
    <text x={kx + 10} y={ky + 22} font-family="Montserrat Variable, sans-serif" font-size="15" font-weight="600" fill="#0a1e4c">Kolwezi</text>
  </g>
</svg>
