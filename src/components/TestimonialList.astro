---
import { Image } from 'astro:assets';
import { getImage, localized, type Testimonial } from '../lib/content';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  items: Testimonial[];
}
const { lang, items } = Astro.props;
---

<ul class="grid gap-6 md:grid-cols-2">
  {
    items.map((item) => (
      <li>
        <figure class="flex h-full flex-col rounded-lg border border-navy/10 bg-white p-6">
          <span class="font-heading text-5xl leading-none text-gold-light" aria-hidden="true">“</span>
          <blockquote class="flex-1 text-lg leading-relaxed text-ink">
            <p>{localized(item, 'quote', lang)}</p>
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-4 border-t border-navy/10 pt-4">
            {item.logo && (
              <Image src={getImage('testimonials', item.logo)} alt="" width={96} densities={[1, 2]} class="h-10 w-auto object-contain" />
            )}
            <div>
              <p class="font-heading font-semibold text-navy">{item.name}</p>
              <p class="text-sm text-muted">{[item.role, item.company].filter(Boolean).join(', ')}</p>
            </div>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
