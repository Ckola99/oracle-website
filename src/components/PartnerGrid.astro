---
import { Image } from 'astro:assets';
import { getImage, type Partner } from '../lib/content';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  partners: Partner[];
  showSince?: boolean;
}
const { lang, partners, showSince = false } = Astro.props;
---

<ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
  {
    partners.map((p) => {
      const logo = (
        <Image src={getImage('partners', p.logo)} alt={p.name} width={200} densities={[1, 2]} class="max-h-16 w-auto object-contain" />
      );
      return (
        <li class="flex flex-col items-center justify-center rounded-lg border border-navy/10 bg-white p-5 text-center">
          {p.url ? (
            <a href={p.url} target="_blank" rel="noopener" aria-label={t(lang, 'partners.visit', { name: p.name })} class="flex h-20 items-center justify-center">
              {logo}
            </a>
          ) : (
            <div class="flex h-20 items-center justify-center">{logo}</div>
          )}
          {showSince && p.since && <p class="mt-2 text-xs text-muted">{t(lang, 'partners.since', { year: p.since })}</p>}
        </li>
      );
    })
  }
</ul>
